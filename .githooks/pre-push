#!/bin/sh
# Runs the gate (`npm run check`) before every push and refuses direct pushes
# to main: this repository lands every change through a squash-merged PR.
# Enable once per checkout with `git config core.hooksPath .githooks`.
set -eu

zero=0000000000000000000000000000000000000000
pushes_commits=0
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo "pre-push: refusing a direct push to main; open a pull request instead." >&2
		exit 1
	fi
	if [ "$local_sha" != "$zero" ]; then
		pushes_commits=1
	fi
done

[ "$pushes_commits" = 1 ] || exit 0

# Git exports GIT_DIR and related variables to hooks; the gate must not
# inherit them, or git commands in its tests act on this repository.
for var in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$var"
done

log=$(mktemp)
trap 'rm -f "$log"' EXIT
if ! npm run check >"$log" 2>&1; then
	cat "$log" >&2
	echo "pre-push: the gate (npm run check) failed; push aborted." >&2
	exit 1
fi
